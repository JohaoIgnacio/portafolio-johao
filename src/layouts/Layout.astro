---
import "../styles/global.css";
import { perfil } from "../data/perfil";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Johao Ignacio Bernal | Jefe de TI, Odoo / ERP e Infraestructura",
  description = "Jefe de TI e ingeniero de sistemas. Implementación y desarrollo de ERP sobre Odoo, infraestructura de servidores y redes, y automatización de procesos. Chiclayo, Perú.",
  image = "/johao-profile.jpg",
} = Astro.props;

/**
 * Solo emitimos URLs absolutas cuando `site` está configurado en astro.config.mjs.
 * Una canónica que apunta a un dominio equivocado es peor que no tener canónica.
 */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: perfil.nombre,
  jobTitle: perfil.titular,
  email: `mailto:${perfil.email}`,
  telephone: perfil.telefono,
  ...(canonical ? { url: canonical } : {}),
  image: ogImage,
  sameAs: [perfil.linkedin, perfil.github],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Chiclayo",
    addressRegion: "Lambayeque",
    addressCountry: "PE",
  },
  knowsAbout: [
    "Dirección de TI",
    "Odoo",
    "ERP",
    "Python",
    "PostgreSQL",
    "Infraestructura de servidores",
    "Redes MikroTik",
    "Automatización de procesos",
    "Gestión de proyectos",
  ],
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Universidad Tecnológica del Perú" },
    { "@type": "CollegeOrUniversity", name: "Harvard University Division of Continuing Education" },
    { "@type": "CollegeOrUniversity", name: "Universidad Privada del Norte" },
  ],
};
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={perfil.nombre} />
    <meta
      name="keywords"
      content="Johao Ignacio Bernal, jefe de TI, gerente de TI, consultor Odoo, desarrollador Odoo, implementacion ERP, infraestructura de servidores, MikroTik, automatizacion de procesos, Chiclayo, Peru"
    />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={perfil.nombre} />
    <meta property="og:locale" content="es_PE" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`Retrato profesional de ${perfil.nombre}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0f766e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a href="#home" class="skip-link">Saltar al contenido</a>
    <slot />
    <script>
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add("visible");
        });
      }, { threshold: 0.08 });

      document.querySelectorAll(".section-reveal").forEach((el) => revealObserver.observe(el));

      const nav = document.getElementById("navbar-inner");
      window.addEventListener("scroll", () => {
        nav?.classList.toggle("scrolled", window.scrollY > 12);
      });

      const links = document.querySelectorAll(".nav-link[data-section]");
      const sections = document.querySelectorAll("section[id]");
      const activeObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => {
            const el = link as HTMLElement;
            el.classList.toggle("active", el.dataset.section === entry.target.id);
          });
        });
      }, { threshold: 0.35 });

      sections.forEach((section) => activeObserver.observe(section));
    </script>
  </body>
</html>
