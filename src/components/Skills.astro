---
const skills = [
  ["Dirección técnica", "Liderazgo de equipos, arquitectura de solución, QA y toma de decisiones."],
  ["Gestión de proyectos", "Scrum, Kanban, comunicación con stakeholders y seguimiento de alcance."],
  ["Consultoría", "Diagnóstico de procesos, levantamiento de requisitos y priorización de impacto."],
  ["Comunicación", "Español nativo, inglés avanzado y presentación ejecutiva de resultados."],
];
---
<section id="skills" class="section bg-white">
  <div class="container">
    <div class="section-reveal">
      <p class="section-kicker">Habilidades</p>
      <h2 class="section-title">Competencias que conectan tecnología con negocio.</h2>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {skills.map(([title, text], index) => (
        <article class="section-reveal card card-hover p-6" style={`transition-delay:${index * .08}s`}>
          <span class="text-sm font-black text-[var(--teal)]">0{index + 1}</span>
          <h3 class="font-display mt-4 text-xl font-black">{title}</h3>
          <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
