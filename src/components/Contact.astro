---
import { perfil } from "../data/perfil";

const email = perfil.email;
const contacts = [
  ["Email", email, `mailto:${email}`],
  ["WhatsApp", perfil.telefono, perfil.whatsapp],
  ["LinkedIn", "Perfil profesional", perfil.linkedin],
  ["GitHub", "Repositorios y código", perfil.github],
  ["Ubicación", `${perfil.ubicacion} · Remoto`, "https://maps.google.com/?q=Chiclayo,Lambayeque,Peru"],
  ...(perfil.cvDisponible ? [["CV", "Descargar en PDF", perfil.cv]] : []),
];
---
<section id="contact" class="section bg-[var(--ink)] text-white">
  <div class="container">
    <div class="section-reveal mb-10">
      <p class="text-xs font-extrabold uppercase tracking-[.18em] text-[#8dd7cf]">Contacto</p>
      <h2 class="font-display mt-4 max-w-4xl text-[clamp(2.4rem,5vw,4.9rem)] font-black leading-[.95]">
        Hablemos de tu ERP, tu infraestructura o el proceso que hoy hacen a mano.
      </h2>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-white/72">
        Implementación y desarrollo sobre Odoo, montaje de servidores y redes, o automatización de procesos. Escríbeme para coordinar una reunión o revisar una oportunidad.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.1fr_.9fr]">
      <form
        id="contact-form"
        class="section-reveal rounded-[8px] border border-white/12 bg-white p-6 text-[var(--ink)] shadow-[var(--shadow)]"
        action={`https://formsubmit.co/ajax/${email}`}
        method="POST"
      >
        <input type="hidden" name="_subject" value="Nuevo mensaje desde el portafolio de Johao" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" />

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-bold">
            Nombre
            <input name="nombre" type="text" required placeholder="Tu nombre" class="min-h-12 rounded-[8px] border border-[var(--line)] px-4 outline-none transition focus:border-[var(--teal)]" />
          </label>
          <label class="grid gap-2 text-sm font-bold">
            Correo
            <input name="email" type="email" required placeholder="tu@email.com" class="min-h-12 rounded-[8px] border border-[var(--line)] px-4 outline-none transition focus:border-[var(--teal)]" />
          </label>
        </div>

        <label class="mt-4 grid gap-2 text-sm font-bold">
          Asunto
          <input name="asunto" type="text" required placeholder="Implementación Odoo, infraestructura, automatización..." class="min-h-12 rounded-[8px] border border-[var(--line)] px-4 outline-none transition focus:border-[var(--teal)]" />
        </label>

        <label class="mt-4 grid gap-2 text-sm font-bold">
          Mensaje
          <textarea name="mensaje" required rows="6" placeholder="Cuéntame qué necesitas resolver." class="resize-none rounded-[8px] border border-[var(--line)] px-4 py-3 outline-none transition focus:border-[var(--teal)]"></textarea>
        </label>

        <p id="contact-status" class="mt-4 hidden rounded-[8px] border border-[var(--line)] bg-[var(--mist)] px-4 py-3 text-sm font-bold text-[var(--teal)]"></p>

        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <button type="submit" class="btn btn-primary">
            Enviar mensaje
          </button>
          <a href={perfil.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Escribir por WhatsApp
          </a>
        </div>
      </form>

      <aside class="section-reveal rounded-[8px] border border-white/12 bg-white/5 p-6" style="transition-delay:.1s">
        <h3 class="font-display text-2xl font-black">Datos directos</h3>
        <p class="mt-2 text-sm leading-6 text-white/62">
          Correo y WhatsApp son los canales más rápidos. Respondo en el día.
        </p>
        <div class="mt-6 grid gap-3">
          {contacts.map(([label, value, href]) => (
            <a href={href} target={href.startsWith("http") ? "_blank" : "_self"} rel="noopener" class="rounded-[8px] border border-white/12 bg-white/7 p-4 transition hover:bg-white/12">
              <span class="block text-xs font-extrabold uppercase tracking-[.14em] text-[#8dd7cf]">{label}</span>
              <span class="mt-1 block break-all text-sm font-bold">{value}</span>
            </a>
          ))}
        </div>
      </aside>
    </div>

    <footer class="mt-16 flex flex-col gap-3 border-t border-white/12 pt-6 text-sm text-white/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 Johao Fabrizio Ignacio Bernal</p>
      <p>Odoo, infraestructura y automatización desde Chiclayo, Perú.</p>
    </footer>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status") as HTMLElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    const submit = form.querySelector("button[type='submit']") as HTMLButtonElement | null;
    status.classList.remove("hidden");
    status.textContent = "Enviando mensaje...";
    submit?.setAttribute("disabled", "true");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (!response.ok) throw new Error("No se pudo enviar el mensaje.");

      form.reset();
      status.textContent = "Mensaje enviado correctamente. Te responderé pronto.";
    } catch {
      status.textContent = "No se pudo enviar ahora. Escríbeme a johaoignaciob@gmail.com o por WhatsApp.";
    } finally {
      submit?.removeAttribute("disabled");
    }
  });
</script>
