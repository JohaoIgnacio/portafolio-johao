---
const contacts = [
  { icon: '📧', label: 'Email',              value: 'jignaciob@mantaro-systems.com', href: 'mailto:jignaciob@mantaro-systems.com', color: '#4285F4', bg: '#E8F0FE' },
  { icon: '📱', label: 'Teléfono / WhatsApp', value: '+51 932 215 727',               href: 'https://wa.me/51932215727',            color: '#34A853', bg: '#E6F4EA' },
  { icon: '📍', label: 'Ubicación',           value: 'Chiclayo, Lambayeque, Perú',    href: 'https://maps.google.com/?q=Chiclayo,Lambayeque,Peru', color: '#EA4335', bg: '#FCE8E6' },
  { icon: '🏢', label: 'Empresa',             value: 'Mantaro Systems SAC',           href: 'https://mantaro-systems.com',          color: '#7c3aed', bg: '#EDE9FE' },
];
---
<section id="contact" class="py-24 bg-[#F8F9FA] relative overflow-hidden">
  <!-- Top separator -->
  <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(to right, transparent, #4285F4 30%, #34A853 60%, transparent)"></div>

  <div class="max-w-5xl mx-auto px-6">
    <!-- Header -->
    <div class="section-reveal mb-14 text-center">
      <div class="section-label mx-auto w-fit">08 — Contacto</div>
      <h2 class="section-heading text-4xl md:text-5xl mt-2">
        ¿<span class="gradient-text">Trabajamos</span> juntos?
      </h2>
      <p class="text-[#5F6368] mt-4 text-base max-w-xl mx-auto leading-relaxed">
        Disponible para proyectos de transformación digital, consultoría tecnológica y desarrollo de software empresarial.
      </p>
      <div class="g-dot-divider justify-center mt-5">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>

    <!-- Contact cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10 section-reveal">
      {contacts.map((c, i) => (
        <a
          href={c.href}
          target={c.href.startsWith('http') ? '_blank' : '_self'}
          rel="noopener"
          class="g-card rounded-2xl p-6 text-center group block hover:scale-[1.03] transition-transform"
          style={`transition-delay:${i*0.07}s; border-top: 3px solid ${c.color}`}
        >
          <div class="w-12 h-12 rounded-2xl mx-auto mb-3 flex items-center justify-center text-2xl"
               style={`background: ${c.bg}`}>
            {c.icon}
          </div>
          <p class="text-xs uppercase tracking-widest font-bold mb-1" style={`color: ${c.color}`}>{c.label}</p>
          <p class="text-sm text-[#202124] font-medium group-hover:font-semibold transition-all break-all">{c.value}</p>
        </a>
      ))}
    </div>

    <!-- CTA Banner -->
    <div class="section-reveal">
      <div class="g-card rounded-3xl p-10 text-center relative overflow-hidden"
           style="border-top: 4px solid; border-image: linear-gradient(to right, #4285F4, #EA4335, #FBBC04, #34A853) 1">
        <h3 class="text-2xl md:text-3xl font-black font-display mb-2 text-[#202124]">
          <span class="gradient-text">Mantaro Systems SAC</span>
        </h3>
        <p class="text-[#80868B] text-xs mb-2 font-mono">RUC 20614491664 · SUNARP Partida 11505313</p>
        <p class="text-[#5F6368] text-base mb-8 max-w-lg mx-auto leading-relaxed">
          Empresa de tecnología especializada en transformación digital del sector público y privado. Consultoría, desarrollo de software y soluciones Azure AI.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="mailto:jignaciob@mantaro-systems.com" class="btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Enviar un mensaje
          </a>
          <a href="https://wa.me/51932215727" target="_blank" rel="noopener" class="btn-outline">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            WhatsApp
          </a>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-14">
      <div class="g-dot-divider justify-center mb-4">
        <span></span><span></span><span></span><span></span>
      </div>
      <p class="text-[#80868B] text-sm">© 2026 Johao Fabrizio Ignacio Bernal · Mantaro Systems SAC</p>
      <p class="mt-1 font-mono text-xs text-[#DADCE0]">Chiclayo, Lambayeque, Perú 🇵🇪</p>
    </div>
  </div>
</section>
