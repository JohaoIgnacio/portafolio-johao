---
const email = "johaoignaciob@gmail.com";
const phone = "+51 932 215 727";
const contacts = [
  ["Email", email, `mailto:${email}`],
  ["WhatsApp", phone, "https://wa.me/51932215727"],
  ["Ubicación", "Chiclayo, Lambayeque, Perú", "https://maps.google.com/?q=Chiclayo,Lambayeque,Peru"],
  ["Rol actual", "Project Manager - Corp. inmobiliaria", "#experience"],
];
---
<section id="contact" class="section bg-[var(--ink)] text-white">
  <div class="container">
    <div class="section-reveal mb-10">
      <p class="text-xs font-extrabold uppercase tracking-[.18em] text-[#8dd7cf]">Contacto</p>
      <h2 class="font-display mt-4 max-w-4xl text-[clamp(2.4rem,5vw,4.9rem)] font-black leading-[.95]">
        Hablemos de automatización, gestión de proyectos y soluciones digitales.
      </h2>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-white/72">
        Escríbeme para coordinar una reunión, revisar una oportunidad laboral o conversar sobre una solución tecnológica.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.1fr_.9fr]">
      <form
        class="section-reveal rounded-[8px] border border-white/12 bg-white p-6 text-[var(--ink)] shadow-[var(--shadow)]"
        action={`mailto:${email}`}
        method="post"
        enctype="text/plain"
      >
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-bold">
            Nombre
            <input name="nombre" type="text" required placeholder="Tu nombre" class="min-h-12 rounded-[8px] border border-[var(--line)] px-4 outline-none transition focus:border-[var(--teal)]" />
          </label>
          <label class="grid gap-2 text-sm font-bold">
            Correo
            <input name="correo" type="email" required placeholder="tu@email.com" class="min-h-12 rounded-[8px] border border-[var(--line)] px-4 outline-none transition focus:border-[var(--teal)]" />
          </label>
        </div>

        <label class="mt-4 grid gap-2 text-sm font-bold">
          Asunto
          <input name="asunto" type="text" required placeholder="Proyecto, entrevista, automatización..." class="min-h-12 rounded-[8px] border border-[var(--line)] px-4 outline-none transition focus:border-[var(--teal)]" />
        </label>

        <label class="mt-4 grid gap-2 text-sm font-bold">
          Mensaje
          <textarea name="mensaje" required rows="6" placeholder="Cuéntame qué necesitas resolver." class="resize-none rounded-[8px] border border-[var(--line)] px-4 py-3 outline-none transition focus:border-[var(--teal)]"></textarea>
        </label>

        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <button type="submit" class="btn btn-primary">
            Enviar por correo
          </button>
          <a href="https://wa.me/51932215727" target="_blank" rel="noopener" class="btn btn-secondary">
            Escribir por WhatsApp
          </a>
        </div>
      </form>

      <aside class="section-reveal rounded-[8px] border border-white/12 bg-white/5 p-6" style="transition-delay:.1s">
        <h3 class="font-display text-2xl font-black">Datos directos</h3>
        <p class="mt-2 text-sm leading-6 text-white/62">
          Canales actuales para contactarme. Respondo principalmente por correo y WhatsApp.
        </p>
        <div class="mt-6 grid gap-3">
          {contacts.map(([label, value, href]) => (
            <a href={href} target={href.startsWith("http") ? "_blank" : "_self"} rel="noopener" class="rounded-[8px] border border-white/12 bg-white/7 p-4 transition hover:bg-white/12">
              <span class="block text-xs font-extrabold uppercase tracking-[.14em] text-[#8dd7cf]">{label}</span>
              <span class="mt-1 block break-all text-sm font-bold">{value}</span>
            </a>
          ))}
        </div>
      </aside>
    </div>

    <footer class="mt-16 flex flex-col gap-3 border-t border-white/12 pt-6 text-sm text-white/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 Johao Fabrizio Ignacio Bernal</p>
      <p>Project Manager, automatización y software desde Chiclayo, Perú.</p>
    </footer>
  </div>
</section>
