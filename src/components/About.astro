---
const profile = [
  ["Rol actual", "Project Manager - Corp. inmobiliaria"],
  ["Ubicación", "Chiclayo, Lambayeque, Perú"],
  ["Email", "johaoignaciob@gmail.com"],
  ["Teléfono", "+51 932 215 727"],
];

const highlights = [
  ["Hult Prize UTP 2026", "1er lugar institucional y representante en etapa nacional."],
  ["Automatización inmobiliaria", "Gestión de flujos, seguimiento comercial y mejora de procesos internos."],
  ["Sector público", "Digitalización, redes, automatización y atención ciudadana."],
  ["Investigación aplicada", "ML, datos y producción de compost orgánico con UTP."],
];
---
<section id="about" class="section bg-white">
  <div class="container">
    <div class="section-reveal">
      <p class="section-kicker">Perfil</p>
      <h2 class="section-title">Un perfil técnico con mentalidad de gestión y automatización.</h2>
      <p class="section-copy">
        Combino gestión de proyectos, ingeniería full stack, analítica de datos e infraestructura. Mi trabajo se concentra en convertir procesos manuales en sistemas medibles, mantenibles y útiles para equipos reales.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-[.85fr_1.15fr]">
      <aside class="section-reveal card p-6">
        <div class="rounded-[8px] bg-[#f2f2f0] p-3">
          <img src="/johao-profile.jpg" alt="Johao Ignacio en traje formal" class="h-[460px] w-full rounded-[6px] object-contain object-center" />
        </div>
        <h3 class="font-display mt-6 text-2xl font-black">Johao Fabrizio</h3>
        <p class="mt-1 text-sm font-semibold text-[var(--teal)]">Ignacio Bernal</p>
        <div class="mt-6 grid gap-3">
          {profile.map(([label, value]) => (
            <div class="border-t border-[var(--line)] pt-3">
              <span class="block text-xs font-extrabold uppercase tracking-[.14em] text-[var(--muted)]">{label}</span>
              <span class="mt-1 block text-sm font-bold text-[var(--ink)]">{value}</span>
            </div>
          ))}
        </div>
      </aside>

      <div class="section-reveal grid content-start gap-5" style="transition-delay:.1s">
        <div class="card p-7">
          <p class="text-lg leading-8 text-[var(--graphite)]">
            Ingeniero de Sistemas de Información con más de 2 años de experiencia progresiva en desarrollo de software empresarial, transformación digital y liderazgo de equipos técnicos.
          </p>
          <p class="mt-5 leading-8 text-[var(--muted)]">
            Actualmente trabajo como Project Manager en una corporación inmobiliaria, impulsando automatizaciones, seguimiento operativo y mejoras en procesos comerciales. Mantengo además experiencia en CRM, gestión municipal, BI financiero, OCR, redes institucionales, Azure AI y automatización de procesos.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {highlights.map(([title, text], index) => (
            <article class="card card-hover p-5" style={`border-top:3px solid ${["var(--teal)", "var(--cobalt)", "var(--amber)", "var(--rose)"][index]}`}>
              <h3 class="font-display text-lg font-extrabold">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
