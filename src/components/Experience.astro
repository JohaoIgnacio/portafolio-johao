---
/**
 * TODO Johao: tres cosas en la entrada de la corporación inmobiliaria.
 *  1. Mes de inicio como Jefe de TI, y si puedes nombrar a la empresa. Un empleador
 *     anónimo junto a otros con nombre genera dudas; si hay NDA, conviene decirlo.
 *  2. Si pasaste de Project Manager a Jefe de TI en la misma empresa, conviene
 *     partir esto en DOS entradas con sus fechas. Una promoción interna es de las
 *     señales más fuertes que puede dar un CV, y ahora mismo no se ve.
 *  3. Tamaño del equipo a tu cargo y presupuesto que gestionas, si son públicos.
 */
const experiences = [
  {
    role: "Jefe de TI",
    company: "Corporación inmobiliaria (nombre reservado)",
    period: "2025 - Presente",
    location: "Chiclayo, Lambayeque, Perú",
    summary:
      "Responsable del área de tecnología de la corporación: defino las prioridades tecnológicas, respondo por la continuidad y la seguridad de la operación, y lidero la implantación y el desarrollo del ERP sobre Odoo.",
    points: [
      "Dirección del área de TI: prioridades, proveedores y continuidad operativa.",
      "Implementación funcional de Odoo y desarrollo de módulos propios en Python.",
      "Migración y depuración de los datos históricos hacia el ERP.",
      "Infraestructura y seguridad: accesos por rol, respaldos y disponibilidad.",
      "Automatización de flujos que antes se ejecutaban a mano.",
      "Reportería de dirección generada por el sistema, no consolidada a mano.",
      "Interlocución con gerencia y con las áreas comercial y administrativa.",
      "Seguimiento de indicadores, entregables y cumplimiento operativo.",
    ],
    tags: ["Dirección de TI", "Odoo", "Python", "PostgreSQL", "Infraestructura", "Automatización"],
  },
  {
    role: "CEO y Fundador · Gerente de Proyectos y Lead Developer",
    company: "Mantaro Systems SAC",
    period: "Nov 2025 - Presente",
    location: "Chiclayo, Lambayeque, Perú",
    summary:
      "Empresa propia desde la que se formalizó la práctica consultora: proyectos de transformación digital, ERP, infraestructura y datos para organizaciones públicas y privadas.",
    points: [
      "Ganador del fondo semilla Reactiva Cultura por USD 5,000.",
      "Propuesta CDP de USD 150,000 seleccionada para Fase 2.",
      "Responsable de la arquitectura de solución y del equipo técnico.",
      "Mejoras operativas estimadas entre 25% y 40% en organizaciones cliente.",
    ],
    tags: ["Odoo", "Azure AI", "React", "Python", "PostgreSQL", "Scrum"],
  },
  {
    role: "Asistente de Investigación · IA y Sistemas",
    company: "Universidad Tecnológica del Perú",
    period: "Abr 2025 - Presente",
    location: "Lima / Chiclayo, Perú",
    summary:
      "Desarrollo de modelos, pipelines y reportes para proyectos académicos de optimización y producción sostenible.",
    points: [
      "Reducción simulada de costos logísticos en 22%.",
      "Más de 500 puntos de datos analizados y documentados.",
      "Tres informes técnicos de respaldo para publicación.",
    ],
    tags: ["Python", "scikit-learn", "pandas", "Power BI"],
  },
  {
    role: "Desarrollador Full Stack y Administrador de Infraestructura",
    company: "Municipalidad Distrital de Reque",
    period: "Ene 2024 - Dic 2024",
    location: "Reque, Chiclayo, Perú",
    summary:
      "Responsable técnico de los sistemas y de la infraestructura municipal completa: del servidor y la red al software que corre encima.",
    points: [
      "Montaje de la estación de servidor: RAID 1, UPS y Windows Server.",
      "Planta de red de 40 nodos con cableado Cat6, WiFi 6 y segmentación.",
      "Firewall perimetral y VPN sobre MikroTik; cero incidentes en 12 meses.",
      "Sistema de registro civil y digitalización con OCR del archivo histórico.",
      "Cinco procesos institucionales automatizados; optimización del 30%.",
    ],
    tags: ["Windows Server", "MikroTik", "VPN", "Java", "Spring Boot", "Python"],
  },
  {
    role: "Consultor Tecnológico Independiente",
    company: "Freelance",
    period: "Ene 2024 - Oct 2025",
    location: "Chiclayo, Lambayeque, Perú",
    summary:
      "Práctica consultora con proyectos municipales, ONG y clientes privados, formalizada posteriormente bajo Mantaro Systems SAC.",
    points: [
      "Entrega de proyectos de ciclo completo asumiendo PM, desarrollo y QA.",
      "Relaciones comerciales recurrentes que dieron origen a la empresa.",
    ],
    tags: ["Java", "Spring Boot", "Node.js", "SQL Server", "React"],
  },
];
---
<section id="experience" class="section">
  <div class="container">
    <div class="section-reveal">
      <p class="section-kicker">Experiencia</p>
      <h2 class="section-title">Trayectoria orientada a proyectos, automatización y sistemas que llegan a producción.</h2>
    </div>

    <div class="timeline mt-12 grid gap-6">
      {experiences.map((exp, index) => (
        <article class="timeline-item section-reveal" style={`transition-delay:${index * .08}s`}>
          <div class="card card-hover p-6">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <span class="section-kicker">{exp.company}</span>
                <h3 class="font-display mt-2 text-2xl font-black">{exp.role}</h3>
                <p class="mt-3 max-w-3xl leading-7 text-[var(--muted)]">{exp.summary}</p>
              </div>
              <div class="shrink-0 text-left lg:text-right">
                <span class="chip">{exp.period}</span>
                <p class="mt-2 text-sm font-semibold text-[var(--muted)]">{exp.location}</p>
              </div>
            </div>

            <ul class="mt-5 grid gap-2 text-sm leading-6 text-[var(--graphite)] md:grid-cols-2">
              {exp.points.map((point) => <li class="border-l-2 border-[var(--teal)] pl-3">{point}</li>)}
            </ul>

            <div class="mt-5 flex flex-wrap gap-2">
              {exp.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
