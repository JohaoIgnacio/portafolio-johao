---
<section id="experience" class="section">
  <div class="container">
    <div class="section-reveal">
      <p class="section-kicker">Experiencia</p>
      <h2 class="section-title">Trayectoria orientada a proyectos, automatización y sistemas que llegan a producción.</h2>
    </div>

    <div class="timeline mt-12 grid gap-6">
      {experiences.map((exp, index) => (
        <article class="timeline-item section-reveal" style={`transition-delay:${index * .08}s`}>
          <div class="card card-hover p-6">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <span class="section-kicker">{exp.company}</span>
                <h3 class="font-display mt-2 text-2xl font-black">{exp.role}</h3>
                <p class="mt-3 max-w-3xl leading-7 text-[var(--muted)]">{exp.summary}</p>
              </div>
              <div class="shrink-0 text-left lg:text-right">
                <span class="chip">{exp.period}</span>
                <p class="mt-2 text-sm font-semibold text-[var(--muted)]">{exp.location}</p>
              </div>
            </div>

            <ul class="mt-5 grid gap-2 text-sm leading-6 text-[var(--graphite)] md:grid-cols-2">
              {exp.points.map((point) => <li class="border-l-2 border-[var(--teal)] pl-3">{point}</li>)}
            </ul>

            <div class="mt-5 flex flex-wrap gap-2">
              {exp.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
