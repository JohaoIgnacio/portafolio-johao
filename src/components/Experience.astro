---
const experiences = [
  {
    role: "Project Manager - Automatización y Operaciones",
    company: "Corporación inmobiliaria",
    period: "Actualidad",
    location: "Chiclayo, Lambayeque, Perú",
    summary: "Gestión de proyectos internos orientados a automatizar procesos comerciales, seguimiento operativo y mejora continua en una corporación del sector inmobiliario.",
    points: ["Coordinación de iniciativas entre equipos comerciales, administrativos y técnicos.", "Automatización de flujos de trabajo para reducir tareas manuales.", "Seguimiento de indicadores, entregables y cumplimiento operativo."],
    tags: ["Project Management", "Automatización", "CRM", "Procesos", "Reporting"],
  },
  {
    role: "CEO & Fundador | Gerente de Proyectos | Lead Developer",
    company: "Mantaro Systems SAC",
    period: "Nov 2025 - Presente",
    location: "Chiclayo, Lambayeque, Perú",
    summary: "Lidera proyectos de transformación digital con Azure AI, desarrollo web, datos e infraestructura.",
    points: ["Ganador del fondo semilla Reactiva Cultura por USD 5,000.", "Propuesta CDP de USD 150,000 seleccionada para Fase 2.", "Mejoras operativas estimadas entre 25% y 40% en organizaciones cliente."],
    tags: ["Azure AI", "React", "Python", "PostgreSQL", "Scrum"],
  },
  {
    role: "Asistente de Investigación - IA & Sistemas",
    company: "Universidad Tecnológica del Perú",
    period: "Abr 2025 - Presente",
    location: "Lima / Chiclayo, Perú",
    summary: "Desarrollo de modelos, pipelines y reportes para proyectos académicos de optimización y producción sostenible.",
    points: ["Reducción simulada de costos logísticos en 22%.", "Más de 500 puntos de datos analizados.", "Tres informes técnicos para respaldo de publicaciones."],
    tags: ["Python", "ML", "pandas", "Power BI"],
  },
  {
    role: "Consultor Tecnológico Independiente",
    company: "Freelance",
    period: "Ene 2024 - Jun 2025",
    location: "Chiclayo, Lambayeque, Perú",
    summary: "Práctica consultora con proyectos municipales, ONG y clientes privados.",
    points: ["Entrega de proyectos full cycle con 100% de cumplimiento en plazo.", "Responsable de PM, desarrollo y QA.", "Relaciones comerciales recurrentes formalizadas bajo Mantaro Systems."],
    tags: ["Java", "Spring Boot", "Node.js", "SQL Server"],
  },
  {
    role: "Desarrollador Full Stack & Administrador de Redes",
    company: "Municipalidad Distrital de Reque",
    period: "Ene 2024 - Dic 2024",
    location: "Reque, Chiclayo, Perú",
    summary: "Automatización de procesos institucionales, sistemas integrados y operación de red municipal.",
    points: ["Optimización de procesos municipales en 30%.", "Cinco procesos clave automatizados.", "Cero incidentes de seguridad durante 12 meses."],
    tags: ["Full Stack", "MikroTik", "VPN", "Windows Server"],
  },
];
---
<section id="experience" class="section">
  <div class="container">
    <div class="section-reveal">
      <p class="section-kicker">Experiencia</p>
      <h2 class="section-title">Trayectoria orientada a proyectos, automatización y sistemas que llegan a producción.</h2>
    </div>

    <div class="timeline mt-12 grid gap-6">
      {experiences.map((exp, index) => (
        <article class="timeline-item section-reveal" style={`transition-delay:${index * .08}s`}>
          <div class="card card-hover p-6">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <span class="section-kicker">{exp.company}</span>
                <h3 class="font-display mt-2 text-2xl font-black">{exp.role}</h3>
                <p class="mt-3 max-w-3xl leading-7 text-[var(--muted)]">{exp.summary}</p>
              </div>
              <div class="shrink-0 text-left lg:text-right">
                <span class="chip">{exp.period}</span>
                <p class="mt-2 text-sm font-semibold text-[var(--muted)]">{exp.location}</p>
              </div>
            </div>

            <ul class="mt-5 grid gap-2 text-sm leading-6 text-[var(--graphite)] md:grid-cols-3">
              {exp.points.map((point) => <li class="border-l-2 border-[var(--teal)] pl-3">{point}</li>)}
            </ul>

            <div class="mt-5 flex flex-wrap gap-2">
              {exp.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
