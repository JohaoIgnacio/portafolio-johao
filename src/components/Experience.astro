---
const colorMap: Record<string, { text: string; bg: string; border: string }> = {
  violet:  { text: '#7c3aed', bg: '#EDE9FE', border: 'rgba(124,58,237,0.2)' },
  cyan:    { text: '#0891b2', bg: '#E0F7FA', border: 'rgba(8,145,178,0.2)'  },
  blue:    { text: '#4285F4', bg: '#E8F0FE', border: 'rgba(66,133,244,0.2)' },
  emerald: { text: '#059669', bg: '#E6F4EA', border: 'rgba(5,150,105,0.2)'  },
};

const experiences = [
  {
    role: 'CEO & Fundador | Gerente de Proyectos | Lead Developer',
    company: 'Mantaro Systems SAC',
    period: 'Nov 2025 — Presente',
    location: 'Chiclayo, Lambayeque, Perú',
    type: 'Fundador',
    color: 'violet',
    highlights: [
      'Fundó Mantaro Systems SAC (RUC 20614491664, SUNARP Partida 11505313) para institucionalizar más de 2 años de práctica consultora.',
      'Lidera equipo multidisciplinario de 5 personas (2 desarrolladores, 1 QA, 1 UX/diseño, 1 especialista en redes) con Scrum y Kanban.',
      'Ganó fondo semilla Reactiva Cultura (USD 5,000) de la Embajada de EE.UU. en Perú — programa altamente competitivo.',
      'Presentando propuesta CDP de USD 150,000 al Programa de Desarrollo de Ciudades de la Embajada de EE.UU. — seleccionado Fase 2.',
      'Entregó soluciones Azure AI logrando mejoras del 25–40% en eficiencia operativa en organizaciones clientes.',
    ],
    tags: ['Azure AI', 'Python', 'React', 'PostgreSQL', 'Scrum', 'AWS'],
  },
  {
    role: 'Asistente de Investigación — IA & Sistemas',
    company: 'Universidad Tecnológica del Perú (UTP)',
    period: 'Abr 2025 — Presente',
    location: 'Lima / Chiclayo, Perú',
    type: 'Investigación',
    color: 'cyan',
    highlights: [
      'Construyó modelos de ML para optimización de cadena de suministro, reduciendo costos logísticos simulados en 22%.',
      'Implementó sistema integrado de gestión de producción de compost orgánico, logrando +15% de eficiencia.',
      'Recopiló y analizó más de 500 puntos de datos; redactó 3 informes técnicos que respaldan publicaciones académicas.',
    ],
    tags: ['Python', 'ML', 'pandas', 'scikit-learn', 'PostgreSQL', 'Power BI'],
  },
  {
    role: 'Consultor Tecnológico Independiente',
    company: 'Persona Natural — Freelance',
    period: 'Ene 2024 — Jun 2025',
    location: 'Chiclayo, Lambayeque, Perú',
    type: 'Freelance',
    color: 'blue',
    highlights: [
      'Práctica consultora pre-constitución: proyectos municipales, de ONG y del sector privado — 100% en plazo.',
      'Entregó proyectos tecnológicos de ciclo completo para clientes municipales y ONG en Lambayeque.',
      'Actuó como PM, Lead Developer y QA en todos los proyectos reflejados en portafolio (proyectos 02–19).',
      'Construyó relaciones recurrentes con clientes, formalizadas bajo Mantaro Systems SAC tras su constitución.',
    ],
    tags: ['Java', 'Spring Boot', 'React', 'Node.js', 'SQL Server', 'REST APIs'],
  },
  {
    role: 'Desarrollador Full Stack & Administrador de Redes',
    company: 'Municipalidad Distrital de Reque',
    period: 'Ene 2024 — Dic 2024',
    location: 'Reque, Chiclayo, Perú',
    type: 'Empleo Municipal',
    color: 'emerald',
    highlights: [
      'Desarrolló sistemas integrados que optimizaron procesos municipales en un 30%, reduciendo tiempos de atención ciudadana.',
      'Automatizó 5 procesos institucionales clave (gestión documental, reportes, control de personal), reduciendo errores manuales en un 25%.',
      'Diseñó e implementó red de radio-transmisor que brindó conectividad estable a 3 oficinas remotas previamente aisladas.',
      'Administró firewalls y micro-servidores institucionales con 0 incidentes de seguridad en 12 meses continuos de operación.',
    ],
    tags: ['Full Stack', 'React', 'Spring Boot', 'MikroTik', 'Firewall', 'VPN'],
  },
];
---
<section id="experience" class="py-24 bg-[#F8F9FA] relative overflow-hidden">
  <div class="absolute left-0 top-0 w-80 h-80 rounded-full opacity-20 pointer-events-none"
       style="background: radial-gradient(circle, rgba(124,58,237,0.15), transparent 70%)"></div>

  <div class="max-w-6xl mx-auto px-6">
    <div class="section-reveal mb-14">
      <div class="section-label">02 — Trayectoria</div>
      <h2 class="section-heading text-4xl md:text-5xl mt-2">
        Experiencia <span class="gradient-text">Profesional</span>
      </h2>
      <div class="g-dot-divider mt-5">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="relative pl-8">
      <!-- Timeline line -->
      <div class="timeline-line rounded-full"></div>

      <div class="space-y-8">
        {experiences.map((exp, i) => {
          const c = colorMap[exp.color] || colorMap['blue'];
          return (
            <div class="section-reveal relative" style={`transition-delay:${i*0.1}s`}>
              <!-- Timeline dot -->
              <div class="absolute -left-[37px] top-7 w-4 h-4 rounded-full border-4 border-[#F8F9FA] shadow-md"
                   style={`background: ${c.text}`}></div>

              <div class="g-card rounded-2xl p-7" style={`border-left: 3px solid ${c.text}`}>
                <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                  <div>
                    <span class="text-xs font-bold uppercase tracking-widest" style={`color: ${c.text}`}>{exp.type}</span>
                    <h3 class="text-lg font-bold text-[#202124] mt-1 font-display">{exp.role}</h3>
                    <p class="font-semibold text-sm mt-0.5" style={`color: ${c.text}`}>{exp.company}</p>
                  </div>
                  <div class="text-right shrink-0">
                    <span class="text-xs text-[#5F6368] px-3 py-1.5 rounded-full font-mono border border-[#E8EAED] bg-[#F1F3F4]">{exp.period}</span>
                    <p class="text-xs text-[#80868B] mt-1.5">📍 {exp.location}</p>
                  </div>
                </div>

                <ul class="space-y-2 mb-5">
                  {exp.highlights.map(h => (
                    <li class="flex gap-2.5 text-sm text-[#5F6368] leading-relaxed">
                      <span class="shrink-0 mt-0.5 font-bold" style={`color: ${c.text}`}>▸</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>

                <div class="flex flex-wrap gap-2">
                  {exp.tags.map(tag => <span class="tech-badge">{tag}</span>)}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
