---
import { perfil } from "../data/perfil";

const metrics = [
  ["Odoo", "Implementación funcional y desarrollo de módulos a medida"],
  ["19", "Proyectos entregados, cinco documentados como caso de estudio"],
  ["40", "Nodos de red y estaciones de servidor montados y operados"],
  ["2+", "Años liderando proyectos de software, datos e infraestructura"],
];

const focus = [
  "Odoo / ERP",
  "Python",
  "PostgreSQL",
  "Docker",
  "Infraestructura",
  "Automatización",
  "Project Management",
];
---
<section id="home" class="relative min-h-screen overflow-hidden pt-16">
  <div class="absolute inset-0 rule-grid opacity-70"></div>
  <div class="container relative grid min-h-[calc(100vh-4rem)] items-center gap-12 py-12 lg:grid-cols-[1.05fr_.95fr]">
    <div class="section-reveal">
      <div class="mb-8 flex flex-wrap items-center gap-3">
        <span class="chip border-[rgba(15,118,110,.35)] bg-[var(--mist)] text-[var(--teal)]">Disponible en Chiclayo, Perú · Remoto</span>
        <span class="chip">Consultor Odoo · Infraestructura · Project Manager</span>
      </div>

      <p class="section-kicker">Portafolio Profesional</p>
      <h1 class="hero-title font-display mt-4 max-w-4xl font-black leading-[.88] tracking-normal">
        Johao Fabrizio Ignacio Bernal
      </h1>
      <p class="hero-copy mt-7 max-w-2xl text-lg leading-8 text-[var(--graphite)]">
        Implanto y desarrollo <strong class="font-bold text-[var(--ink)]">ERP sobre Odoo</strong>, monto
        <strong class="font-bold text-[var(--ink)]">infraestructura de servidores y redes</strong> de punta a punta,
        y automatizo los procesos que hoy alguien hace a mano. Ingeniero de sistemas y Project Manager:
        gestiono el proyecto y también escribo el código.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#portfolio" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Ver casos de estudio
        </a>
        {perfil.cvDisponible ? (
          <a href={perfil.cv} class="btn btn-secondary" download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Descargar CV
          </a>
        ) : (
          <a href={perfil.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0ZM.3 8.2h4.4V24H.3V8.2Zm7.7 0h4.2v2.2h.06c.6-1.1 2.04-2.3 4.2-2.3 4.5 0 5.34 2.9 5.34 6.7V24h-4.4v-7.3c0-1.75-.03-4-2.46-4-2.46 0-2.84 1.9-2.84 3.87V24H8V8.2Z" />
            </svg>
            Ver perfil en LinkedIn
          </a>
        )}
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-4">
        {metrics.map(([value, label], index) => (
          <div class="metric" style={`border-color:${["var(--teal)", "var(--cobalt)", "var(--graphite)", "var(--amber)"][index]}`}>
            <strong>{value}</strong>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="section-reveal lg:justify-self-end" style="transition-delay:.12s">
      <div class="relative">
        <div class="absolute -left-5 top-8 hidden h-[86%] w-[86%] border border-[var(--ink)] md:block"></div>
        <figure class="relative overflow-hidden rounded-[8px] border border-[var(--line)] bg-white shadow-[var(--shadow)]">
          <img
            src="/johao-profile.jpg"
            alt="Retrato profesional de Johao Fabrizio Ignacio Bernal"
            width="430"
            height="640"
            fetchpriority="high"
            class="h-[560px] w-full object-cover object-[center_20%] sm:h-[640px] lg:w-[430px]"
          />
          <figcaption class="border-t border-[var(--line)] bg-white p-5">
            <span class="block text-xs font-extrabold uppercase tracking-[.18em] text-[var(--teal)]">Especialización</span>
            <span class="mt-1 block text-sm font-semibold text-[var(--graphite)]">
              ERP Odoo, infraestructura y automatización de procesos.
            </span>
          </figcaption>
        </figure>
      </div>

      <div class="mt-5 flex flex-wrap gap-2">
        {focus.map((item) => <span class="chip">{item}</span>)}
      </div>
    </div>
  </div>
</section>
