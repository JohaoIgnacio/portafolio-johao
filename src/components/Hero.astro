---
const metrics = [
  ["2+", "años liderando soluciones de software, datos e infraestructura"],
  ["19", "proyectos entregados con foco en impacto operativo"],
  ["270+", "beneficiarios directos en iniciativas públicas y educativas"],
  ["PM", "gestión de proyectos y automatizaciones inmobiliarias"],
];

const focus = ["Project Management", "Automatizaciones", "CRM", "Azure AI", "Power BI", "PostgreSQL", "Scrum"];
---
<section id="home" class="relative min-h-screen overflow-hidden pt-16">
  <div class="absolute inset-0 rule-grid opacity-70"></div>
  <div class="container relative grid min-h-[calc(100vh-4rem)] items-center gap-12 py-12 lg:grid-cols-[1.05fr_.95fr]">
    <div class="section-reveal">
      <div class="mb-8 flex flex-wrap items-center gap-3">
        <span class="chip border-[rgba(15,118,110,.35)] bg-[var(--mist)] text-[var(--teal)]">Disponible en Chiclayo, Perú</span>
        <span class="chip">Project Manager · Software Engineer · Automatización</span>
      </div>

      <p class="section-kicker">Portafolio Profesional</p>
      <h1 class="hero-title font-display mt-4 max-w-4xl font-black leading-[.88] tracking-normal">
        Johao Fabrizio Ignacio Bernal
      </h1>
      <p class="hero-copy mt-7 max-w-2xl text-lg leading-8 text-[var(--graphite)]">
        Project Manager en una corporación inmobiliaria e ingeniero de software especializado en automatización, transformación digital, datos e infraestructura para equipos operativos y comerciales.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#portfolio" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Ver proyectos
        </a>
        <a href="#contact" class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 6h16v12H4V6Zm0 1 8 6 8-6" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          </svg>
          Contactar
        </a>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-4">
        {metrics.map(([value, label], index) => (
          <div class="metric" style={`border-color:${["var(--teal)", "var(--cobalt)", "var(--amber)", "var(--rose)"][index]}`}>
            <strong>{value}</strong>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="section-reveal lg:justify-self-end" style="transition-delay:.12s">
      <div class="relative">
        <div class="absolute -left-5 top-8 hidden h-[86%] w-[86%] border border-[var(--ink)] md:block"></div>
        <figure class="relative overflow-hidden rounded-[8px] border border-[var(--line)] bg-white shadow-[var(--shadow)]">
          <img src="/johao-profile.jpg" alt="Retrato profesional de Johao Fabrizio Ignacio Bernal" class="h-[560px] w-full object-cover object-[center_20%] sm:h-[640px] lg:w-[430px]" />
          <figcaption class="border-t border-[var(--line)] bg-white p-5">
            <span class="block text-xs font-extrabold uppercase tracking-[.18em] text-[var(--teal)]">Identidad profesional</span>
            <span class="mt-1 block text-sm font-semibold text-[var(--graphite)]">Gestión, ingeniería y automatización desde Perú.</span>
          </figcaption>
        </figure>
      </div>

      <div class="mt-5 flex flex-wrap gap-2">
        {focus.map((item) => <span class="chip">{item}</span>)}
      </div>
    </div>
  </div>
</section>
