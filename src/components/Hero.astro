---
---
<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden hero-bg pt-20">

  <!-- Subtle grid pattern -->
  <div class="absolute inset-0 opacity-[0.025] pointer-events-none"
       style="background-image: linear-gradient(rgba(66,133,244,1) 1px, transparent 1px), linear-gradient(90deg, rgba(66,133,244,1) 1px, transparent 1px); background-size: 56px 56px;"></div>

  <!-- Decorative blobs -->
  <div class="absolute top-20 right-10 w-80 h-80 rounded-full opacity-20 pointer-events-none"
       style="background: radial-gradient(circle, rgba(66,133,244,0.3), transparent 70%);"></div>
  <div class="absolute bottom-20 left-10 w-64 h-64 rounded-full opacity-15 pointer-events-none"
       style="background: radial-gradient(circle, rgba(52,168,83,0.4), transparent 70%);"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] rounded-full opacity-10 pointer-events-none"
       style="background: radial-gradient(ellipse, rgba(251,188,4,0.2), transparent 70%);"></div>

  <!-- Particle canvas -->
  <canvas id="hero-particles" class="absolute inset-0 pointer-events-none opacity-40"></canvas>

  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">

    <!-- Google dots + status -->
    <div class="flex items-center justify-center gap-4 mb-8" style="animation: fadeInUp 0.7s ease both;">
      <div class="g-dot-divider">
        <span></span><span></span><span></span><span></span>
      </div>
      <div class="flex items-center gap-2 glass px-4 py-2 rounded-full text-xs border border-[#E8EAED]">
        <span class="w-2 h-2 bg-[#34A853] rounded-full" style="animation: blink 2s infinite;"></span>
        <span class="text-[#5F6368] font-medium">Disponible · Chiclayo, Perú</span>
      </div>
      <div class="g-dot-divider" style="transform:scaleX(-1)">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>

    <!-- Main heading -->
    <h1 class="section-heading mb-5" style="animation: fadeInUp 0.7s 0.1s ease both; opacity:0; animation-fill-mode:forwards;">
      <span class="block text-5xl md:text-7xl lg:text-8xl text-[#202124] tracking-tight">JOHAO</span>
      <span class="block text-5xl md:text-7xl lg:text-8xl gradient-text-google tracking-tight">FABRIZIO</span>
      <span class="block text-xl md:text-2xl text-[#5F6368] font-light mt-3 tracking-[.15em] uppercase">Ignacio Bernal</span>
    </h1>

    <!-- Typing subtitle -->
    <div class="flex items-center justify-center gap-1.5 h-9 mb-10" style="animation: fadeInUp 0.7s 0.22s ease both; opacity:0; animation-fill-mode:forwards;">
      <span id="typing-el" class="text-base md:text-lg text-[#4285F4] font-mono font-semibold"></span>
      <span class="cursor-blink w-0.5 h-5 bg-[#4285F4] inline-block rounded-full"></span>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10 max-w-2xl mx-auto" style="animation: fadeInUp 0.7s 0.34s ease both; opacity:0; animation-fill-mode:forwards;">
      {[
        { value: '2+',   label: 'Años experiencia',    color: '#4285F4' },
        { value: '19',   label: 'Proyectos entregados', color: '#EA4335' },
        { value: '270+', label: 'Beneficiarios',        color: '#FBBC04' },
        { value: '$5K',  label: 'Fondo US Embassy',     color: '#34A853' },
      ].map(stat => (
        <div class="g-card-flat p-4 hover:scale-105 transition-transform text-center">
          <div class="text-2xl md:text-3xl font-black font-display" style={`color: ${stat.color}`}>{stat.value}</div>
          <div class="text-xs text-[#5F6368] mt-1 leading-tight">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center items-center mb-10" style="animation: fadeInUp 0.7s 0.46s ease both; opacity:0; animation-fill-mode:forwards;">
      <a href="#portfolio" class="btn-primary">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m0 0l7-7m-7 7l7 7"/>
        </svg>
        Ver Portfolio
      </a>
      <a href="#techstack" class="btn-outline">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
        </svg>
        Ver Tech Stack
      </a>
      <a href="mailto:jignaciob@mantaro-systems.com" class="text-sm text-[#5F6368] hover:text-[#4285F4] transition-colors font-medium flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        jignaciob@mantaro-systems.com
      </a>
    </div>

    <!-- Tech badges -->
    <div class="flex flex-wrap justify-center gap-2" style="animation: fadeInUp 0.7s 0.58s ease both; opacity:0; animation-fill-mode:forwards;">
      {['Azure AI', 'Python', 'React', 'Spring Boot', 'PostgreSQL', 'SAP', 'Power BI', 'MikroTik', 'AWS', 'Excel'].map((tech, i) => (
        <span class="tech-badge" style={`animation-delay: ${i * 0.06}s`}>{tech}</span>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-[#80868B] pointer-events-none">
    <span class="text-[10px] uppercase tracking-[0.2em] font-semibold">Scroll</span>
    <div class="w-5 h-8 border-2 border-[#DADCE0] rounded-full flex justify-center pt-1.5">
      <div class="w-1 h-1.5 bg-[#4285F4] rounded-full" style="animation: float 1.5s ease-in-out infinite;"></div>
    </div>
  </div>
</section>

<script>
  // Typing animation
  const titles = [
    'CEO & Fundador · Mantaro Systems SAC',
    'Ingeniero de Software',
    'Azure AI & Ciencia de Datos',
    'Ganador Hult Prize UTP 2026',
    'Lead Developer & Project Manager',
    'Python · React · SAP · Power BI',
  ];
  let ti = 0, ci = 0, deleting = false;
  const el = document.getElementById('typing-el');
  function type() {
    if (!el) return;
    const current = titles[ti];
    if (!deleting) {
      el.textContent = current.slice(0, ++ci);
      if (ci === current.length) { deleting = true; setTimeout(type, 2000); return; }
    } else {
      el.textContent = current.slice(0, --ci);
      if (ci === 0) { deleting = false; ti = (ti + 1) % titles.length; }
    }
    setTimeout(type, deleting ? 40 : 75);
  }
  type();

  // Particle canvas
  const canvas = document.getElementById('hero-particles') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const colors = ['#4285F4','#EA4335','#FBBC04','#34A853'];
    let particles: {x:number,y:number,vx:number,vy:number,r:number,alpha:number,c:string}[] = [];
    const resize = () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; };
    resize();
    window.addEventListener('resize', resize);
    for (let i = 0; i < 50; i++) {
      particles.push({
        x: Math.random() * canvas.width, y: Math.random() * canvas.height,
        vx: (Math.random()-0.5)*0.35, vy: (Math.random()-0.5)*0.35,
        r: Math.random()*2+0.5, alpha: Math.random()*0.35+0.05,
        c: colors[Math.floor(Math.random()*colors.length)]
      });
    }
    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0,0,canvas.width,canvas.height);
      particles.forEach(p => {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0) p.x = canvas.width;
        if (p.x > canvas.width) p.x = 0;
        if (p.y < 0) p.y = canvas.height;
        if (p.y > canvas.height) p.y = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
        ctx.fillStyle = p.c + Math.round(p.alpha*255).toString(16).padStart(2,'0');
        ctx.fill();
      });
      requestAnimationFrame(draw);
    }
    draw();
  }
</script>
