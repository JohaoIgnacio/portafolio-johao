      { name: 'Spring Boot',  icon: 'springboot',  color: '#6DB33F', level: 82 },
      { name: 'Astro',        icon: 'astro',       color: '#FF5D01', level: 85 },
      { name: 'Next.js',      icon: 'nextdotjs',   color: '#000000', level: 75 },
      { name: 'pandas',       icon: 'pandas',      color: '#150458', level: 87 },
      { name: 'FastAPI',      icon: 'fastapi',     color: '#009688', level: 78 },
      { name: 'Svelte',       icon: 'svelte',      color: '#FF3E00', level: 72 },
    ],
  },
  {
    id: 'enterprise',
    label: '🏢 Herramientas Empresariales',
    color: '#EA4335',
    techs: [
      { name: 'SAP',              icon: 'sap',              color: '#0FAAFF', level: 80 },
      { name: 'Microsoft Excel',  icon: 'microsoftexcel',   color: '#217346', level: 92 },
      { name: 'Power BI',         icon: 'powerbi',          color: '#F2C811', level: 85 },
      { name: 'Power Automate',   icon: 'powerautomate',    color: '#0066FF', level: 78 },
      { name: 'SharePoint',       icon: 'microsoftsharepoint', color: '#0078D4', level: 72 },
      { name: 'Teams',            icon: 'microsoftteams',   color: '#6264A7', level: 88 },
      { name: 'Word',             icon: 'microsoftword',    color: '#2B579A', level: 90 },
