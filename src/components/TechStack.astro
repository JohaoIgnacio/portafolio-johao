---
const groups = [
  ["ERP & Odoo", ["Odoo 19", "Studio", "Python", "ORM Odoo", "PostgreSQL", "Migración de datos"]],
  ["Backend & APIs", ["Java", "Spring Boot", "Node.js", "FastAPI", "REST APIs", "TypeScript"]],
  ["Frontend", ["React", "Astro", "Next.js", "JavaScript", "HTML", "CSS", "Tailwind"]],
  ["Datos & BI", ["Power BI", "pandas", "NumPy", "scikit-learn", "SQL Server", "Azure AI"]],
  ["Automatización", ["n8n", "WhatsApp Business API", "Meta Ads", "Power Automate", "Apps Script", "Cron"]],
  ["Infraestructura", ["Linux", "Windows Server", "Docker", "Nginx", "MikroTik", "VPN", "RAID", "Git"]],
];
---
<section id="techstack" class="section">
  <div class="container">
    <div class="section-reveal">
      <p class="section-kicker">Stack</p>
      <h2 class="section-title">Herramientas para construir, desplegar y sostener.</h2>
      <p class="section-copy">
        Selección orientada a sistemas que entran en operación y siguen funcionando: ERP, APIs,
        datos, contenedores, red y perímetro.
      </p>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {groups.map(([title, items], index) => (
        <article class="section-reveal card card-hover p-5" style={`transition-delay:${index * .07}s; border-top:3px solid ${["var(--teal)", "var(--cobalt)", "var(--rose)", "var(--amber)", "var(--graphite)"][index]}`}>
          <h3 class="font-display text-xl font-black">{title}</h3>
          <div class="mt-5 flex flex-wrap gap-2">
            {items.map((item) => <span class="chip">{item}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
