    techs: [
      { name: 'Azure',        icon: 'microsoftazure', color: '#0078D4', level: 87 },
      { name: 'AWS',          icon: 'amazonaws',      color: '#FF9900', level: 78 },
      { name: 'Google Cloud', icon: 'googlecloud',    color: '#4285F4', level: 65 },
