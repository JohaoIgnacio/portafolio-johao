      { name: 'TypeScript', icon: 'typescript',  color: '#3178C6', level: 85 },
      { name: 'Java',       icon: 'java',        color: '#007396', level: 82 },
      { name: 'SQL',        icon: 'postgresql',  color: '#336791', level: 90 },
      { name: 'HTML5',      icon: 'html5',       color: '#E34F26', level: 90 },
      { name: 'CSS3',       icon: 'css3',        color: '#1572B6', level: 85 },
      { name: 'C++',        icon: 'cplusplus',   color: '#00599C', level: 60 },
    ],
  },
  {
