---
import { perfil } from "../data/perfil";

const links = [
  ["about", "Perfil"],
  ["experience", "Experiencia"],
  ["portfolio", "Proyectos"],
  ["skills", "Competencias"],
  ["education", "Formación"],
  ["contact", "Contacto"],
];

/** En las páginas de caso los anclas deben volver al home antes de saltar a la sección. */
const base = Astro.url.pathname === "/" ? "" : "/";
---
<header class="fixed inset-x-0 top-0 z-50">
  <nav id="navbar-inner" class="nav-shell">
    <div class="container flex h-16 items-center justify-between">
      <a href={`${base}#home`} class="flex items-center gap-3" aria-label="Ir al inicio">
        <span class="grid h-10 w-10 place-items-center rounded-[8px] bg-[var(--ink)] text-sm font-black text-white">JB</span>
        <span class="hidden leading-tight sm:block">
          <span class="block text-sm font-extrabold">Johao Ignacio</span>
          <span class="block text-[11px] font-bold uppercase tracking-[.18em] text-[var(--teal)]">Jefe de TI · Odoo</span>
        </span>
      </a>

      <ul class="hidden items-center gap-6 lg:flex">
        {links.map(([id, label]) => (
          <li><a href={`${base}#${id}`} class="nav-link" data-section={id}>{label}</a></li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <a href={perfil.linkedin} target="_blank" rel="noopener noreferrer" class="icon-btn hidden sm:grid" aria-label="LinkedIn de Johao Ignacio">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0ZM.3 8.2h4.4V24H.3V8.2Zm7.7 0h4.2v2.2h.06c.6-1.1 2.04-2.3 4.2-2.3 4.5 0 5.34 2.9 5.34 6.7V24h-4.4v-7.3c0-1.75-.03-4-2.46-4-2.46 0-2.84 1.9-2.84 3.87V24H8V8.2Z" />
          </svg>
        </a>
        <a href={perfil.github} target="_blank" rel="noopener noreferrer" class="icon-btn hidden sm:grid" aria-label="GitHub de Johao Ignacio">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58v-2.2c-3.34.72-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.1-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.62-2.8 5.64-5.48 5.94.43.37.82 1.1.82 2.22v3.29c0 .32.21.69.83.57A12 12 0 0 0 12 .5Z" />
          </svg>
        </a>
        <a href={`${base}#contact`} class="btn btn-primary hidden sm:inline-flex">
          <span>Contactar</span>
        </a>
        <button id="menu-btn" class="grid h-11 w-11 place-items-center rounded-[8px] border border-[var(--line)] bg-white lg:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden border-t border-[var(--line)] bg-[var(--paper)] px-4 py-4 lg:hidden">
      <div class="container grid gap-2">
        {links.map(([id, label]) => (
          <a href={`${base}#${id}`} class="mobile-link rounded-[8px] px-3 py-3 text-sm font-bold text-[var(--graphite)]">{label}</a>
        ))}
        <div class="mt-2 flex gap-2">
          <a href={perfil.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary flex-1">LinkedIn</a>
          <a href={perfil.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary flex-1">GitHub</a>
        </div>
        <a href={`${base}#contact`} class="btn btn-primary mt-1">Enviar mensaje</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(open));
  });

  document.querySelectorAll(".mobile-link").forEach((link) =>
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
    })
  );
</script>
