---
const links = [
  ["about", "Perfil"],
  ["experience", "Experiencia"],
  ["portfolio", "Proyectos"],
  ["techstack", "Stack"],
  ["awards", "Logros"],
  ["contact", "Contacto"],
];
---
<header class="fixed inset-x-0 top-0 z-50">
  <nav id="navbar-inner" class="nav-shell">
    <div class="container flex h-16 items-center justify-between">
      <a href="#home" class="flex items-center gap-3" aria-label="Ir al inicio">
        <span class="grid h-10 w-10 place-items-center rounded-[8px] bg-[var(--ink)] text-sm font-black text-white">JB</span>
        <span class="hidden leading-tight sm:block">
          <span class="block text-sm font-extrabold">Johao Ignacio</span>
          <span class="block text-[11px] font-bold uppercase tracking-[.18em] text-[var(--teal)]">Software & AI</span>
        </span>
      </a>

      <ul class="hidden items-center gap-7 lg:flex">
        {links.map(([id, label]) => (
          <li><a href={`#${id}`} class="nav-link" data-section={id}>{label}</a></li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <a href="mailto:johaoignaciob@gmail.com" class="btn btn-primary hidden sm:inline-flex">
          <span>Contactar</span>
        </a>
        <button id="menu-btn" class="grid h-11 w-11 place-items-center rounded-[8px] border border-[var(--line)] bg-white lg:hidden" aria-label="Abrir menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden border-t border-[var(--line)] bg-[var(--paper)] px-4 py-4 lg:hidden">
      <div class="container grid gap-2">
        {links.map(([id, label]) => (
          <a href={`#${id}`} class="rounded-[8px] px-3 py-3 text-sm font-bold text-[var(--graphite)]" onclick="document.getElementById('mobile-menu').classList.add('hidden')">{label}</a>
        ))}
        <a href="mailto:johaoignaciob@gmail.com" class="btn btn-primary mt-2">Enviar mensaje</a>
      </div>
    </div>
  </nav>
</header>

<script>
  document.getElementById("menu-btn")?.addEventListener("click", () => {
    document.getElementById("mobile-menu")?.classList.toggle("hidden");
  });
</script>
