  {
    icon: '🏆',
    title: '1er Lugar — Hult Prize UTP 2026',
    org: 'Hult Prize | Universidad Tecnológica del Perú',
    year: '2026',
    color: '#FBBC04',
    bg: '#FEF7E0',
    badge: 'Ganador Nacional',
    description: 'Ganó la competencia institucional Hult Prize UTP 2026 junto a compañeros de equipo Rosmel Cruz y Diego Cacho. La propuesta de startup se enfocó en economía circular. Actualmente representa a la UTP en la Etapa Nacional del Hult Prize en Perú — una de las competencias de emprendimiento estudiantil más grandes del mundo (130+ países).',
  },
  {
    icon: '🇺🇸',
    title: 'Fondo Semilla — Reactiva Cultura',
    org: 'Embajada de EE.UU. en Perú',
    year: '2025',
    color: '#4285F4',
    bg: '#E8F0FE',
    badge: 'USD $5,000',
    description: 'Seleccionado competitivamente como ganador del fondo semilla Reactiva Cultura (USD 5,000), apoyando a emprendedores peruanos que combinan innovación tecnológica con impacto cultural y social. Este reconocimiento abrió el acceso a la red del Programa de Desarrollo de Ciudades (CDP).',
  },
  {
    icon: '🏙️',
    title: 'Postulante CDP — Programa de Desarrollo de Ciudades',
    org: 'Embajada de EE.UU. Lima',
    year: '2025–2026',
    color: '#0891b2',
    bg: '#E0F7FA',
    badge: 'Fase 2 Seleccionado',
    description: 'Presentó propuesta de USD 150,000 a través de Mantaro Systems SAC para la transformación digital integral de una municipalidad distrital en Lambayeque, abarcando digitalización del registro civil, infraestructura LAN/WiFi, plataformas de gestión municipal y fortalecimiento de capacidades institucionales.',
  },
];

const leadership = [
  {
    icon: '🌍',
    title: 'Representante Etapa Nacional — Hult Prize',
    org: 'Hult Prize | UTP',
    period: '2026 — Presente',
    color: '#FBBC04',
    bg: '#FEF7E0',
    points: [
      'Ganó el Hult Prize UTP 2026 institucional (1er lugar) con propuesta de startup de economía circular.',
      'Representa a la UTP en la Etapa Nacional del Hult Prize — compitiendo por un lugar en el Acelerador Global.',
    ],
  },
  {
    icon: '🎓',
    title: 'Director Regional de Educación Tecnológica',
    org: 'REDMUN Lambayeque',
    period: 'Abr 2025 — Presente',
    color: '#7c3aed',
    bg: '#EDE9FE',
    points: [
      'Organizó 5 talleres de educación tecnológica llegando a más de 120 jóvenes en la región Lambayeque.',
      'Capacitó a 30 menores de bajos recursos en alfabetización digital, mejorando competencias básicas en un 80%.',
      'Coordinó 15 delegados en simulaciones de Naciones Unidas, logrando 3 reconocimientos regionales.',
    ],
  },
  {
    icon: '💡',
    title: 'Líder de Innovación y Aprendizaje Creativo',
    org: 'Make the Difference',
    period: 'Mar 2025 — Presente',
    color: '#0891b2',
    bg: '#E0F7FA',
    points: [
      'Implementó tecnologías educativas innovadoras en 3 centros juveniles, impactando a más de 150 estudiantes.',
      'Lideró 5 proyectos de educación digital con metodologías creativas, capacitando a 20 docentes.',
      'Diseñó 2 plataformas educativas que mejoraron la accesibilidad al aprendizaje en un 40%.',
    ],
  },
];
---
<section id="awards" class="py-24 bg-white relative overflow-hidden">
  <div class="absolute left-1/2 top-0 -translate-x-1/2 w-[500px] h-48 rounded-full opacity-20 pointer-events-none"
       style="background: radial-gradient(ellipse, rgba(251,188,4,0.3), transparent 70%)"></div>

  <div class="max-w-6xl mx-auto px-6">
    <!-- Awards header -->
    <div class="section-reveal mb-14">
      <div class="section-label" style="background:#FEF7E0; color:#D97706">04 — Reconocimientos</div>
      <h2 class="section-heading text-4xl md:text-5xl mt-2">
        Premios & <span style="background:linear-gradient(135deg,#FBBC04,#F59E0B,#EA4335);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Reconocimientos</span>
      </h2>
      <div class="g-dot-divider mt-5">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-20">
      {awards.map((a, i) => (
        <div
          class="section-reveal g-card rounded-2xl p-7 relative overflow-hidden"
          style={`transition-delay:${i*0.1}s; border-top: 3px solid ${a.color}`}
        >
          <div class="flex items-start justify-between mb-4">
            <span class="text-4xl">{a.icon}</span>
            <span class="text-xs font-bold px-3 py-1 rounded-full"
                  style={`color: ${a.color}; background: ${a.bg}; border: 1px solid ${a.color}40`}>
              {a.badge}
            </span>
          </div>
          <h3 class="text-base font-bold mb-1 font-display" style={`color: ${a.color}`}>{a.title}</h3>
          <p class="text-xs text-[#80868B] mb-4">{a.org} · {a.year}</p>
          <p class="text-sm text-[#5F6368] leading-relaxed">{a.description}</p>
        </div>
      ))}
    </div>

    <!-- Leadership header -->
    <div class="section-reveal mb-12">
      <div class="section-label">05 — Liderazgo</div>
      <h2 class="section-heading text-4xl md:text-5xl mt-2">
        Liderazgo & <span class="gradient-text">Compromiso Cívico</span>
      </h2>
      <div class="g-dot-divider mt-5">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {leadership.map((l, i) => (
        <div
          class="section-reveal g-card rounded-2xl p-7"
          style={`transition-delay:${i*0.1}s; border-top: 3px solid ${l.color}`}
        >
          <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-2xl mb-4"
               style={`background: ${l.bg}`}>
            {l.icon}
          </div>
          <h3 class="font-bold text-[#202124] mb-1 font-display text-sm">{l.title}</h3>
          <p class="text-xs text-[#80868B] mb-4">{l.org} · {l.period}</p>
          <ul class="space-y-2">
            {l.points.map(pt => (
              <li class="flex gap-2 text-sm text-[#5F6368] leading-relaxed">
                <span class="shrink-0 mt-0.5 font-bold" style={`color: ${l.color}`}>▸</span>
                {pt}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
