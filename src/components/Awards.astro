---
const awards = [
  ["1er Lugar - Hult Prize UTP 2026", "Competencia institucional de emprendimiento. Representante en etapa nacional del Hult Prize en Perú."],
  ["Fondo Semilla Reactiva Cultura", "Seleccionado por la Embajada de EE.UU. en Perú con un fondo de USD 5,000 para innovación con impacto."],
  ["CDP - Programa de Desarrollo de Ciudades", "Propuesta de USD 150,000 seleccionada para Fase 2 desde Mantaro Systems SAC."],
];

const leadership = [
  ["REDMUN Lambayeque", "Director Regional de Educación Tecnológica. 5 talleres y 120+ jóvenes alcanzados."],
  ["Make the Difference", "Liderazgo de innovación y aprendizaje creativo en centros juveniles."],
  ["Hult Prize", "Representación de UTP con propuesta de startup de economía circular."],
];
---
<section id="awards" class="section bg-white">
  <div class="container">
    <div class="section-reveal">
      <p class="section-kicker">Logros</p>
      <h2 class="section-title">Reconocimientos que validan impacto, liderazgo y ejecución.</h2>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {awards.map(([title, text], index) => (
        <article class="section-reveal card card-hover p-6" style={`transition-delay:${index * .08}s; border-top:3px solid ${["var(--amber)", "var(--cobalt)", "var(--teal)"][index]}`}>
          <span class="section-kicker">Reconocimiento</span>
          <h3 class="font-display mt-3 text-2xl font-black">{title}</h3>
          <p class="mt-4 text-sm leading-7 text-[var(--muted)]">{text}</p>
        </article>
      ))}
    </div>

    <div class="section-reveal mt-16">
      <p class="section-kicker">Liderazgo</p>
      <h3 class="font-display mt-3 text-3xl font-black">Trabajo con comunidades, educación e innovación social.</h3>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {leadership.map(([title, text], index) => (
        <article class="section-reveal card p-5" style={`transition-delay:${index * .08}s`}>
          <h4 class="font-display text-xl font-black">{title}</h4>
          <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
