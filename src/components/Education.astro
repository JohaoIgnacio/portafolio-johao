---
const education = [
  ["Ingeniería de Sistemas de Información", "Universidad Tecnológica del Perú", "Mar 2020 - Dic 2025", "Análisis de datos, arquitectura e integración de sistemas."],
  ["Programa Aspire Leaders", "Universidad de Harvard", "Ene - Mar 2025", "Liderazgo global para estudiantes de primera generación."],
  ["Gestión de Proyectos", "WE - Plataforma de aprendizaje", "2025", "Planificación, riesgos, recursos, QA y comunicación."],
  ["Analista de Datos", "Platzi", "Ene - Jun 2025", "Power BI, business intelligence e integración de datos."],
  ["Full Stack Developer", "Oracle Academy", "2024", "Desarrollo full stack, ciencias de la computación y UI/UX."],
  ["Analista Junior en Ciberseguridad", "Cisco Networking Academy", "2024", "Redes, análisis de seguridad y protocolos."],
  ["Inglés Avanzado", "ICPNA", "Ene 2024 - Dic 2025", "Comunicación técnica y empresarial en inglés."],
];
---
<section id="education" class="section">
  <div class="container">
    <div class="section-reveal">
      <p class="section-kicker">Formación</p>
      <h2 class="section-title">Base académica y aprendizaje continuo.</h2>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {education.map(([degree, institution, period, detail], index) => (
        <article class="section-reveal card card-hover p-5" style={`transition-delay:${index * .05}s`}>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="font-display text-xl font-black">{degree}</h3>
              <p class="mt-1 text-sm font-bold text-[var(--teal)]">{institution}</p>
            </div>
            <span class="chip shrink-0">{period}</span>
          </div>
          <p class="mt-4 text-sm leading-6 text-[var(--muted)]">{detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>
