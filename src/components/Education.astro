---
<section id="education" class="py-24 bg-[#F8F9FA] relative overflow-hidden">
  <div class="absolute right-0 bottom-0 w-72 h-72 rounded-full opacity-20 pointer-events-none"
       style="background: radial-gradient(circle, rgba(66,133,244,0.2), transparent 70%)"></div>

  <div class="max-w-6xl mx-auto px-6">
    <div class="section-reveal mb-14">
      <div class="section-label">06 — Formación</div>
      <h2 class="section-heading text-4xl md:text-5xl mt-2">
        Educación & <span class="gradient-text">Certificaciones</span>
      </h2>
      <div class="g-dot-divider mt-5">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {education.map((edu, i) => (
        <div
          class="section-reveal g-card rounded-2xl p-6 flex gap-5"
          style={`transition-delay:${i * 0.08}s; border-left: 3px solid ${edu.color}`}
        >
          <!-- Icon -->
          <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl shrink-0"
               style={`background: ${edu.bg}`}>
            {edu.icon}
          </div>

          <!-- Content -->
          <div class="flex-1 min-w-0">
            <span class="text-xs font-bold uppercase tracking-widest" style={`color: ${edu.color}`}>{edu.type}</span>
            <h3 class="text-sm font-bold text-[#202124] mt-1 font-display leading-snug">{edu.degree}</h3>
            <p class="text-xs font-semibold mt-0.5" style={`color: ${edu.color}`}>{edu.institution}</p>
            <p class="text-xs text-[#80868B] mt-1 font-mono">{edu.period} · {edu.location}</p>
            <div class="flex flex-wrap gap-1.5 mt-3">
              {edu.highlights.map(h => (
                <span class="text-xs text-[#5F6368] bg-[#F1F3F4] border border-[#E8EAED] px-2 py-0.5 rounded-md">{h}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
