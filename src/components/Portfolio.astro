  { id:'01', name:'Plataforma CRM – Sector Inmobiliario',          roles:'PM + Lead Dev + QA', stack:'React, Java, Spring Boot, PostgreSQL, AWS',      result:'Ciclo lead-to-contract -35%; 50+ usuarios activos' },
  { id:'02', name:'Sistema Digital de Registro Civil',             roles:'Lead Dev + QA',       stack:'Java, React, PostgreSQL, Spring Boot',           result:'Consulta de registros: de 2-6 hrs a menos de 5 min' },
