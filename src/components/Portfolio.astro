---
import { getCollection } from "astro:content";
import { otrosProyectos } from "../data/otros-proyectos";

const destacados = (await getCollection("proyectos"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const accentVar = {
  teal: "var(--teal)",
  cobalt: "var(--cobalt)",
  amber: "var(--amber)",
  rose: "var(--rose)",
  graphite: "var(--graphite)",
} as const;
---
<section id="portfolio" class="section bg-white">
  <div class="container">
    <div class="section-reveal">
      <p class="section-kicker">Proyectos</p>
      <h2 class="section-title">Cinco casos que explican cómo trabajo.</h2>
      <p class="section-copy">
        ERP sobre Odoo, infraestructura de servidores, producto a medida, gobierno digital y
        automatización de procesos. Cada caso incluye el problema real, la arquitectura y las
        decisiones que determinaron el resultado.
      </p>
    </div>

    <div class="mt-12 grid gap-6">
      {destacados.map((proyecto, index) => (
        <a
          href={`/proyectos/${proyecto.id}/`}
          class="case-card section-reveal card card-hover"
          style={`transition-delay:${index * .07}s; --accent:${accentVar[proyecto.data.accent]}`}
        >
          <div class="case-card__body">
            <div class="flex flex-wrap items-center gap-3">
              <span class="case-card__num">{String(index + 1).padStart(2, "0")}</span>
              <span class="chip">{proyecto.data.category}</span>
              <span class="text-xs font-bold uppercase tracking-[.14em] text-[var(--muted)]">
                {proyecto.data.period}
              </span>
            </div>

            <h3 class="font-display mt-5 text-[clamp(1.5rem,2.6vw,2.1rem)] font-black leading-tight">
              {proyecto.data.title}
            </h3>
            <p class="mt-3 max-w-2xl leading-7 text-[var(--graphite)]">{proyecto.data.tagline}</p>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-[var(--muted)]">{proyecto.data.summary}</p>

            <div class="mt-5 flex flex-wrap gap-2">
              {proyecto.data.stack.slice(0, 6).map((tech) => <span class="chip">{tech}</span>)}
            </div>

            <span class="case-card__cta mt-6">
              Ver caso completo
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>

          <div class="case-card__results">
            {proyecto.data.results.map((r) => (
              <div>
                <strong>{r.value}</strong>
                <span>{r.label}</span>
              </div>
            ))}
          </div>
        </a>
      ))}
    </div>

    <details class="section-reveal mt-10 card p-6">
      <summary class="cursor-pointer list-none">
        <span class="font-display text-xl font-black">Otros {otrosProyectos.length} proyectos entregados</span>
        <span class="mt-1 block text-sm text-[var(--muted)]">
          Datos y BI, investigación aplicada, IA en la nube y plataformas educativas. Pulsa para desplegar.
        </span>
      </summary>

      <div class="mt-6 grid gap-3">
        {otrosProyectos.map((p) => (
          <div class="grid gap-1 border-t border-[var(--line)] pt-3 md:grid-cols-[1.1fr_.9fr_1fr] md:gap-6">
            <span class="text-sm font-extrabold">{p.name}</span>
            <span class="text-sm text-[var(--muted)]">{p.stack}</span>
            <span class="text-sm font-semibold text-[var(--graphite)]">{p.result}</span>
          </div>
        ))}
      </div>
    </details>
  </div>
</section>
