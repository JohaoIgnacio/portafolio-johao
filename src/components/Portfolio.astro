  { id:'10', name:'Modelo ML – Optimización Cadena de Suministro',roles:'Lead Dev',             stack:'Python, scikit-learn, pandas',                   result:'Costos logísticos simulados reducidos en 22%' },
  { id:'11', name:'Firewall Institucional y Endurecimiento',       roles:'Arquitecto + QA',      stack:'MikroTik, Windows Server, Firewalls',            result:'0 incidentes de seguridad en 12 meses continuos' },
  { id:'12', name:'Red de Radio-Transmisor – 3 Oficinas Remotas', roles:'PM + Lead Dev',        stack:'Redes de radio, TCP/IP, VPN',                    result:'Conectividad estable para 3 oficinas antes aisladas' },
  { id:'13', name:'Automatización de 5 Procesos Institucionales', roles:'Lead Dev + QA',        stack:'Python, REST APIs, SQL',                         result:'Errores manuales -25%; tiempo de atención ciudadana -30%' },
